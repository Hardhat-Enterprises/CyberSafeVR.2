  m_Name: Scenario_04_TelstraAccount
  m_EditorClassIdentifier: 
  scenarioTitle: Telstra Account Suspended
  introNarration: Your phone provider appears to be contacting you.
  senderName: TelstraAU
  messageBody: 'Your Telstra bill payment failed. Account will be suspended in 2
    hours. Update payment details here: bit.ly/tls-pay-9823'
  embeddedUrl: bit.ly/tls-pay-9823
  correctAction: 0
  isLegitimate: 0
  correctFeedback: Well done! Shortened URLs like bit.ly hide the real destination.
    Legitimate companies use their own domains.
  incorrectFeedback: 'Always suspicious: shortened URLs (bit.ly) hide where they
    lead. Telstra would use telstra.com.au. Never click shortened links from unknown
    senders.'
  redFlags:
  - Shortened URL (bit.ly hides the real domain)
  - Urgency (2 hours)
  - Threat of service suspension
  - Requests payment details via link
  difficultyLevel: 1
