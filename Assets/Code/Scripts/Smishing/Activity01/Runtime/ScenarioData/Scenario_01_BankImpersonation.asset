  m_Name: Scenario_01_BankImpersonation
  m_EditorClassIdentifier: 
  scenarioTitle: Bank Account Alert
  introNarration: A text just came in. Your phone buzzes. Read it carefully.
  senderName: +61 456 789 012
  messageBody: 'URGENT: Your ANZ account has been compromised. Click the link IMMEDIATELY
    to secure your account or it will be suspended in 1 hour.'
  embeddedUrl: http://secure-anz-banking.ru/verify
  correctAction: 0
  isLegitimate: 0
  correctFeedback: Excellent! The .ru domain and urgency language were clear red
    flags. ANZ would never contact you this way.
  incorrectFeedback: This was a smishing attempt. The URL uses a foreign .ru domain
    impersonating ANZ. Legitimate banks never ask you to verify accounts via SMS
    links.
  redFlags:
  - Urgency language (URGENT, IMMEDIATELY, 1 hour)
  - Suspicious foreign domain (.ru, not .com.au)
  - Threat of account suspension
  - Generic sender number (not a verified short-code)
  difficultyLevel: 1
